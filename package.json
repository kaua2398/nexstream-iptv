{
  "name": "nexstream-iptv",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @nexstream/web --filter @nexstream/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @nexstream/api prisma:generate",
    "db:migrate": "pnpm --filter @nexstream/api prisma:migrate",
    "db:studio": "pnpm --filter @nexstream/api prisma:studio"
  },
  "devDependencies": {
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.14",
    "typescript": "5.8.3"
  }
}
