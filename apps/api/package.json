{
  "name": "@nexstream/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../../prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@nexstream/shared": "workspace:*",
    "@prisma/client": "6.9.0",
    "axios": "1.10.0",
    "compression": "1.8.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "ipaddr.js": "2.2.0",
    "jose": "6.0.11",
    "pino": "9.7.0",
    "pino-http": "10.4.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "9.28.0",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "22.15.31",
    "eslint": "9.28.0",
    "prisma": "6.9.0",
    "supertest": "7.1.1",
    "tsx": "4.20.3",
    "typescript-eslint": "8.34.1",
    "vitest": "3.2.3"
  }
}
