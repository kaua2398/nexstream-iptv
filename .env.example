NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
API_PORT=4000
DATABASE_URL=postgresql://nexstream:nexstream@postgres:5432/nexstream?schema=public

# Generate each value independently. Never reuse keys.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
CREDENTIAL_ENCRYPTION_KEY_BASE64=replace-with-32-byte-base64-key
OPAQUE_ID_ENCRYPTION_KEY_BASE64=replace-with-another-32-byte-base64-key
RESOURCE_TOKEN_ENCRYPTION_KEY_BASE64=replace-with-another-32-byte-base64-key
IMAGE_TOKEN_ENCRYPTION_KEY_BASE64=replace-with-another-32-byte-base64-key

ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
PLAYBACK_TOKEN_TTL_SECONDS=180
SESSION_IDLE_TTL_SECONDS=43200
MAX_CONCURRENT_STREAMS=2
TRUSTED_PROXY_HOPS=1

NEXT_PUBLIC_API_BASE_URL=/api
